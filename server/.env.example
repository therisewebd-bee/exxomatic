# ─── Database (Supabase / Aiven PostgreSQL) ────────────────
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# ─── Application ──────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
PORT=5001
TCP_PORT=5000

# ─── Performance Tuning ──────────────────────────────────
BUFFER_FLUSH_INTERVAL=120000
WS_BATCH_INTERVAL=250
CLUSTER_WORKERS=2

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_random_256_bit_secret
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change_me_to_a_random_cookie_secret

# ─── Frontend (for CORS allowlist) ────────────────────────
FRONTEND_URL=https://fleettrackerd.onrender.com

# ─── Cloudflare Email Worker (geofence breach alerts) ─────
EMAIL_WORKER_URL=https://your-email-worker.workers.dev

# ─── Data Retention ──────────────────────────────────────
LOG_RETENTION_DAYS=30
